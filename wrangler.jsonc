{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madhuportfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Created by `wrangler hyperdrive create <name> --connection-string=<DATABASE_URL>`.
  // Paste the resulting id below — see DEPLOYMENT.md.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "aefeb571688b49a1953c680b39570b57",
      // Never actually connected to — opennextjs-cloudflare's `deploy` command starts a local
      // Miniflare proxy just to collect env vars/bindings before the real remote deploy, and that
      // proxy setup fails without *some* Postgres-shaped connection string here. Any dummy value works.
      "localConnectionString": "postgresql://user:password@localhost:5432/postgres",
    },
  ],
  // Per-client-IP cap on /api/linkedin-thumb and /api/instagram-thumb (src/lib/thumb-proxy.ts).
  // A page shows at most a few dozen thumbnails and the browser caches each for a day, so 60 a
  // minute only ever trips on scripted traffic. `namespace_id` is any account-unique integer.
  "ratelimits": [
    {
      "name": "THUMB_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Uploads (bucket `images`) are no longer bound here: they are served from R2's custom domain
  // and written by the studio on Vercel through R2's S3 API — see DEPLOYMENT.md.
  "r2_buckets": [
    // Backs OpenNext's incremental cache — see open-next.config.ts. Create it once with
    // `wrangler r2 bucket create madhuportfolio-cache`.
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "madhuportfolio-cache",
    },
  ],
  // Backs OpenNext's tag cache (open-next.config.ts). `opennextjs-cloudflare deploy` creates the
  // `revalidations` table in it.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "madhuportfolio-tag-cache",
      "database_id": "8b534561-88ed-4ac9-8519-35fcd4c1d00c",
    },
  ],
  // The Durable Object tag cache/queue are no longer bound (they burned the free DO quota). The
  // migration stays because Cloudflare already applied it; the classes are still exported by worker.js.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOShardedTagCache", "DOQueueHandler"],
    },
  ],
}
