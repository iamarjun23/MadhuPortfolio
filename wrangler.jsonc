{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madhu-edit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Created by `wrangler hyperdrive create <name> --connection-string=<DATABASE_URL>`.
  // Paste the resulting id below — see DEPLOYMENT.md.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "images",
    },
  ],
}
