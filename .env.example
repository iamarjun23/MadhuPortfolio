# Copy to `.env` and fill in: Next.js, the Prisma CLI and the scripts all read that file.
# Never commit the real `.env`. Deployed values live in Vercel and Cloudflare; see DEPLOYMENT.md.

# --- Database ----------------------------------------------------------------------------------
# Postgres. The studio reads and writes it, and `pnpm build` reads it too: the public pages are
# prerendered from the published content, so a build without it fails.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# `pnpm dev` emulates the Worker's Hyperdrive binding with this; usually the same as DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Studio sign-in (Auth.js) ------------------------------------------------------------------
# At least 32 characters: `openssl rand -base64 32`. Vercel builds fail without it.
AUTH_SECRET=""
# The studio's own origin. Production (Vercel) needs https://studio.nmadhukumar.com.
AUTH_URL="http://localhost:3000"

# --- Media uploads (R2) ------------------------------------------------------------------------
# Written through R2's S3 API (Cloudflare → R2 → Manage API tokens) and served from the bucket's
# custom domain. Leave the R2_* keys empty to run the studio with uploads disabled.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="images"
NEXT_PUBLIC_MEDIA_URL="https://media.nmadhukumar.com"

# --- Split deployment --------------------------------------------------------------------------
# Leave these unset locally, where one server serves everything. With PUBLIC_SITE_URL set, a
# local publish would clear the live site's cache.
# Cloudflare Worker build: where /studio, /login and /api/auth redirect to.
# STUDIO_URL="https://studio.nmadhukumar.com"
# Vercel (studio): the live site a publish refreshes. Required for production builds.
# PUBLIC_SITE_URL="https://nmadhukumar.com"
# Both deployments: the shared secret for that refresh. Required for Vercel production builds.
# REVALIDATE_SECRET=""

# --- Owner account (`pnpm admin:create`) -------------------------------------------------------
# Creates or updates the single studio owner. Remove the password once the account exists.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""
