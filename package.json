{
  "name": "madhu-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-next-build.mjs",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "node scripts/clean-next-build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "seed": "tsx prisma/seed.ts",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm prisma:validate && pnpm build",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "7.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pg-cloudflare": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  }
}
