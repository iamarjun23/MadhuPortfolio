# dependencies
node_modules/
.pnpm-store/
# pnpm only (pnpm-lock.yaml); a stray `npm install` must not reintroduce npm's lockfile
package-lock.json
.yarn/
.pnp.*

# next.js
.next/
out/
next-env.d.ts

# builds
build/
dist/

# typescript
*.tsbuildinfo

# env — never commit real secrets
.env
.env.*
# the template has placeholders only, and is the documented list of variables
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# runtime
pids
*.pid
*.seed
*.pid.lock

# testing / coverage
coverage/
.nyc_output/

# caches
.cache/
.turbo/
.vercel/
.swc/
.eslintcache
.stylelintcache

# cloudflare / opennext
.open-next/
.wrangler/
/cloudflare-env.d.ts
.dev.vars
.dev.vars.*

# prisma — keep schema & migrations, drop local db files
src/generated/prisma/
src/generated/prisma-node/
prisma/*.db
prisma/*.db-journal

# uploads / local media dumps
/uploads/
public/uploads/

# editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# claude / agent scratch
.claude/
skills-lock.json
scratchpad/

# docker local overrides
docker-compose.override.yml

# misc
*.local
tmp/
temp/

# docs, tests and legacy static references stay local
*.md
tests/
scripts/browser-smoke.mjs
index_6.html
admin_1.html
